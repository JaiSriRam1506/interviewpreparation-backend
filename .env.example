# Backend example environment
# Copy to backend/.env and fill values.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# LiveKit (Screen Share)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Optional: screen-share cleanup cron
SCREEN_SHARE_CLEANUP_ENABLED=1
SCREEN_SHARE_CLEANUP_CRON=*/10 * * * *

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/parakeet_ai

# Auth (set strong secrets)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Speech-to-text providers
# Realtime (word-by-word) STT via AssemblyAI (recommended for iPhone/Android)
ENABLE_ASSEMBLYAI_REALTIME=1
ASSEMBLYAI_API_KEY=

# Batch STT providers used by /sessions/:id/transcribe
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# ElevenLabs Scribe STT
# Provider: set session settings sttProvider=elevenlabs (recommended), or set STT_PROVIDER=elevenlabs
# Model IDs: scribe_v1 | scribe_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2
# enable_logging=true stores transcription history; set 0 for no history (requires eligible plan)
ELEVENLABS_STT_ENABLE_LOGGING=1

# Client-side ElevenLabs Realtime (recommended for lowest latency):
# - Browser connects directly to ElevenLabs WS using a single-use token
# - Backend must have ELEVENLABS_API_KEY and exposes GET /api/v1/stt/elevenlabs/token (requires auth)

# STT tuning
# response_format: json|text|srt|vtt|verbose_json (json is default)
STT_RESPONSE_FORMAT=json
GROQ_STT_RESPONSE_FORMAT=
OPENAI_STT_RESPONSE_FORMAT=

# Prompt max chars sent to STT providers (keep small for speed)
STT_PROMPT_MAX_CHARS=320

# Optional: Local STT using faster-whisper (requires Python + pip install faster-whisper)
# Select provider in UI: "faster-whisper (local)"
FASTER_WHISPER_PYTHON=python
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_VAD_FILTER=1

# Faster-whisper extra tuning
# Disable conditioning on previous text for lower latency / fewer "carry-over" errors
FASTER_WHISPER_CONDITION_ON_PREV=0
# Optional: bias transcription vocabulary (keep short)
FASTER_WHISPER_INITIAL_PROMPT=

# Optional: AI correction for transcripts (used when client sends correctWithAi=1)
STT_AI_CORRECT_ENABLED=true

# Optional: Bias transcript correction toward technical terms
# If unset, backend uses a built-in default technical vocabulary list.
# You can paste your own comma-separated terms here to prioritize spellings.
STT_DOMAIN_VOCAB=
STT_AI_CORRECT_VOCAB=

# Max chars of vocab appended into the correction prompt (defaults to 3500)
STT_AI_CORRECT_VOCAB_MAX_CHARS=3500

# WebSocket PCM streaming gateway (AudioWorklet client)
# Hard cap to prevent unbounded memory growth per WS connection.
STT_WS_MAX_BYTES=15728640

# AI Answer (Parakeet-style JSON)
# Endpoint: POST /api/v1/sessions/:id/ai-answer/parakeet
# Uses the same provider keys as other AI features.
# Optional: override the model used for Parakeet JSON output.
AI_ANSWER_PARAKEET_MODEL_OVERRIDE=
